PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
# Option A (recommended for local Windows + Vercel): standard connection string from Atlas → Connect → Drivers
# MONGODB_URI=mongodb://<user>:<password>@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/ai-digital-presence?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Option B: SRV string (may fail locally with querySrv ECONNREFUSED on some networks)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-digital-presence?retryWrites=true&w=majority

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=replace_with_64_char_random_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_64_char_random_secret_for_refresh_token

# OpenAI (use gpt-4o-mini for lowest cost)
OPENAI_API_KEY=sk-replace_with_your_openai_key
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Gemini 2.5 Flash support)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Published site base URL
PUBLISHED_BASE_URL=https://sites.presence.ai
